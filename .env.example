# Copy to .env next to compose.yaml.
# Mount one broad root so every library folder lives under it (see docs/deploy.md).
PHOTOS_ROOT=/home
TZ=Asia/Shanghai
# Single-user mode (uncomment the PUID/PGID lines in compose.yaml as well):
# PUID=1000
# PGID=10
# Pin the image to one version (e.g. to roll back); remove the line to follow :latest again.
# I2N_TAG=0.1.1
